# Copy this file to .env and put your Anthropic API key in it. Never commit .env.
# Leave the key empty to use your Claude Code login instead.
ANTHROPIC_API_KEY=

# Optional Streamlit app settings (defaults shown).
# The src.extract command line ignores these and uses its own flags, except the API key.
# Keep comments on their own line: text after a value becomes part of the value.

# Backend: api, cli, or auto (api if a key is set).
# EXTRACT_BACKEND=auto
# CLAUDE_MODEL=claude-opus-5-5
# Effort: low, medium, high, xhigh, or max.
# EFFORT=high
# RETRIES=1

# Approach: voted (team default, see docs/adr/0001) or one-pass.
# voted = 1 split call + VOTES label calls per answer. one-pass = 1 call.
# APPROACH=voted
# VOTES=5
# SPLIT_PROMPT=prompts/segment_v1.md
# LABEL_PROMPT=prompts/label_v1.md
# PROMPT_PATH=prompts/extract_v2.md

# DATA_PATH=data/finance-filtered.jsonl
# OUTPUT_DIR=results/app

# Cheaper for testing the app (uncomment all three):
# CLAUDE_MODEL=claude-sonnet-5-5
# EFFORT=medium
# VOTES=3
